# ==============================================================================
# Root Environment Template (Mirrors backend/.env.example & frontend/.env.example)
# Lihat `backend/.env.example` untuk konfigurasi penuh server Django + Kriptografi
# dan `frontend/.env.example` untuk konfigurasi klien React + Vite.
# ==============================================================================

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_50_PLUS_CHAR_HIGH_ENTROPY_DJANGO_SECRET_KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kriptografi UU PDP No. 27/2022 (AES-256-GCM 32-byte key & HMAC-SHA256 Pepper)
NIK_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NIK_HMAC_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
PDF_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=900

# JWT & Rate Limiting Guardrails
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_HOURS=8
AUTH_LOGIN_RATE_LIMIT=10/15m
PUBLIC_PORTAL_RATE_LIMIT_PER_MIN=5
PUBLIC_PORTAL_NIK_LOCKOUT_ATTEMPTS=5
PUBLIC_PORTAL_NIK_LOCKOUT_SECONDS=900

# External API Keys (Zero-PII Gemini Flash & Cloudflare Turnstile)
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_FLASH_API_KEY
GEMINI_MODEL_NAME=gemini-2.5-flash
TURNSTILE_SECRET_KEY=CHANGE_ME_CLOUDFLARE_TURNSTILE_SECRET_KEY

# Frontend Public Env
VITE_API_BASE_URL=http://localhost:8000/api
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
