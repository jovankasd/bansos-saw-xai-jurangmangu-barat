# ==============================================================================
# SISTEM PENDUKUNG KEPUTUSAN HIBRIDA (SAW + XAI GEMINI) BANSOS JURANGMANGU BARAT
# Template Konfigurasi Environment & Secret Management (UU PDP No. 27/2022)
# ==============================================================================
# PERINGATAN KEAMANAN (SECURITY GUARDRAILS):
# 1. JANGAN PERNAH melakukan commit file `.env` asli ke Git!
# 2. Salin file ini menjadi `.env` (`Copy-Item .env.example .env`) dan ganti
#    seluruh nilai placeholder dengan kunci kriptografi acak yang kuat.
# 3. `NIK_AES_KEY`, `NIK_HMAC_PEPPER`, dan `DJANGO_SECRET_KEY` WAJIB memiliki
#    nilai yang berbeda satu sama lain (Prinsip Key Separation).
# ==============================================================================

# --- 1. Django Core & Environment Mode ---
# Gunakan False secara default (Fail-Closed). Set True HANYA pada pengembangan lokal.
DJANGO_DEBUG=False
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_50_PLUS_CHAR_HIGH_ENTROPY_DJANGO_SECRET_KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- 2. Kriptografi Pelindungan Data Pribadi (UU PDP No. 27/2022) ---
# Wajib tepat 32 byte (256-bit) dalam UTF-8, atau 64 karakter hex, atau base64 (32B).
# Generate 64-char hex (32 bytes) via: python -c "import secrets; print(secrets.token_hex(32))"
NIK_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server-side secret pepper untuk deterministic indexing `nik_hash` (HMAC-SHA256).
# Wajib minimal 32 karakter dan BERBEDA dari NIK_AES_KEY serta DJANGO_SECRET_KEY.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
NIK_HMAC_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Masa berlaku token bertanda tangan (TimestampSigner) untuk unduh PDF individual (detik)
PDF_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=900

# --- 3. Autentikasi Staf (SimpleJWT) & Guardrails ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_HOURS=8
AUTH_LOGIN_RATE_LIMIT=10/15m

# --- 4. CORS & Integrasi Frontend (Eksplisit, DILARANG menggunakan '*') ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 5. Google Gemini Flash API (Zero-PII XAI Explainer Layer) ---
# Opsional saat pengembangan lokal karena sistem memiliki `deterministic_fallback.py`.
# DILARANG mengirim nama, NIK, No KK, atau alamat ke endpoint Gemini API.
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_FLASH_API_KEY
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_RETRIES=2

# --- 6. Proteksi Anti-Bot & Lockout Portal Publik (/cek-bansos) ---
TURNSTILE_SECRET_KEY=CHANGE_ME_CLOUDFLARE_TURNSTILE_SECRET_KEY
PUBLIC_PORTAL_RATE_LIMIT_PER_MIN=5
PUBLIC_PORTAL_NIK_LOCKOUT_ATTEMPTS=5
PUBLIC_PORTAL_NIK_LOCKOUT_SECONDS=900
